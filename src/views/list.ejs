<%- include('./includes/head', { pageCSS: pageCSS }) %>
<%- include('./includes/nav') %>

<!-- INCLUDE: MESSAGE -->
<%- include('./includes/messages') %>

<div class="container py-5">

  <!-- Cabeçalho -->
  <div class="d-flex justify-content-between align-items-center mb-4 list-header flex-wrap gap-3">

    <div>
      <h2 class="mb-0">Ocorrências</h2>

      <p class="text-muted mb-0" style="font-size:.875rem;">
        Todas as ocorrências registradas na plataforma
      </p>
    </div>

    <a href="/mapa" class="btn btn-success fw-bold">
      <i class="bi bi-plus-lg me-1"></i>
      Nova ocorrência
    </a>

  </div>

  <!-- Flash sucesso -->
  <% if (success && success.length > 0) { %>

    <div
      class="alert alert-success mb-4"
      style="border-radius:var(--radius);font-size:.875rem;"
    >
      <i class="bi bi-check-circle me-1"></i>
      <%= success[0] %>
    </div>

  <% } %>

  <!-- Estado vazio -->
  <% if (occurrences.length === 0) { %>

    <div class="empty-state">

      <div>
        <i class="bi bi-inbox"></i>
      </div>

      <p>Nenhuma ocorrência registrada ainda.</p>

      <a href="/mapa" class="btn btn-success mt-2">
        Registrar primeira ocorrência
      </a>

    </div>

  <% } %>

  <!-- Grid -->
  <div class="row g-3">

    <% occurrences.forEach(occ => { %>

      <div class="col-12 col-md-6 col-lg-4">

        <div class="occ-card">

          <div class="occ-card-body">

            <span class="occ-type-badge" data-type="<%= occ.type %>">
              <i class="bi bi-exclamation-triangle-fill"></i>
              <%= occ.type %>
            </span>

            <h5 class="occ-title">
              <%= occ.street %>
            </h5>

            <p class="occ-district">
              <i
                class="bi bi-geo-alt me-1"
                style="color:var(--green);"
              ></i>

              <%= occ.district %>
            </p>

            <p class="occ-author">
              <i class="bi bi-person-fill me-1"></i>

              Por:
              <%= occ.user ? occ.user.name : 'Anônimo' %>
            </p>

          </div>

          <div class="occ-card-footer">

            <a
              href="/ocorrencias/<%= occ.id %>"
              class="btn btn-sm btn-outline-secondary flex-grow-1"
            >
              <i class="bi bi-eye me-1"></i>
              Ver detalhes
            </a>

            <% if (currentUserId && currentUserId === occ.userId) { %>

              <a
                href="/ocorrencias/<%= occ.id %>/editar"
                class="btn btn-sm btn-outline-primary"
              >
                <i class="bi bi-pencil"></i>
              </a>

            <% } %>

          </div>

        </div>

      </div>

    <% }) %>

  </div>

  <!-- Paginação -->
  <% if (occurrences.length > 0) { %>

    <div class="d-flex justify-content-center align-items-center gap-2 mt-5">

      <% if (currentPage > 1) { %>

        <a
          href="/ocorrencias?page=<%= currentPage - 1 %>"
          class="btn btn-outline-secondary"
        >
          <i class="bi bi-arrow-left me-1"></i>
          Anterior
        </a>

      <% } %>

      <% if (hasMore) { %>

        <a
          href="/ocorrencias?page=<%= currentPage + 1 %>"
          class="btn btn-success"
        >
          Ver mais
          <i class="bi bi-arrow-right ms-1"></i>
        </a>

      <% } %>

    </div>

  <% } %>

</div>

<%- include('./includes/footer') %>