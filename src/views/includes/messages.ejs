<% if (errors.length > 0) { %>

<div class="flash-wrapper mt-3">
    <div class="row justify-content-center my-3">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="alert alert-danger alert-dismissible fade show flashMsg text-center">

                <% errors.forEach(function(error) { %>
                    <%= error %> <br>
                <% }) %>

            </div>

        </div>
    </div>
</div>

<% } %>



<% if (success.length> 0) { %>

    <div class="flash-wrapper mt-3">
       <div class="row justify-content-center my-3">
        <div class="col-12 col-md-8 col-lg-6">

            <div class="alert alert-success alert-dismissible fade show flashMsg" role="alert">

                <% success.forEach(function(message) { %>
                    <%= message %> <br>
                        <% }) %>

            </div>

        </div>
    </div> 
    </div>
    

<% } %>