<% if (errors.length > 0) { %>

    <div class="flash-wrapper">
        <div class="alert alert-danger alert-dismissible fade show flashMsg text-center" role="alert">
            <% errors.forEach(function(error, i) { %>
                <%= error %><% if (i < errors.length - 1) { %><br><% } %>
            <% }) %>
        </div>
    </div>

<% } %>

<% if (success.length > 0) { %>

    <div class="flash-wrapper">
        <div class="alert alert-success alert-dismissible fade show flashMsg text-center" role="alert">
            <% success.forEach(function(message, i) { %>
                <%= message %><% if (i < success.length - 1) { %><br><% } %>
            <% }) %>
        </div>
    </div>

<% } %>