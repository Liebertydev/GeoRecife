<%- include('./includes/head', { pageCSS: pageCSS }) %>
<%- include('./includes/nav') %>

<div class="form-wrapper">

  <div class="form-card">

    <!-- Cabeçalho do formulário -->
    <div class="form-card-header">
      <h2><i class="bi bi-pencil-fill me-2"></i>Editar Ocorrência</h2>
      <p>Atualize as informações da ocorrência abaixo.</p>
    </div>

    <div class="form-card-body">

      <!-- INCLUDE: MESSAGE -->
      <% if (errors && errors.length > 0) { %>
        <div class="alert alert-danger mb-4" style="border-radius:var(--radius);font-size:.875rem;">
          <% errors.forEach(err => { %>
            <p class="mb-0"><i class="bi bi-exclamation-circle me-1"></i><%= err %></p>
          <% }) %>
        </div>
      <% } %>

      <form action="/ocorrencias/<%= occurrence.id %>/editar" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="latitude"  value="<%= occurrence.latitude %>">
        <input type="hidden" name="longitude" value="<%= occurrence.longitude %>">

        <!-- Localização -->
        <div class="form-section-divider">
          <span><i class="bi bi-geo-alt me-1"></i>Localização</span>
        </div>

        <div class="mb-3">
          <label class="form-label">Rua / Local</label>
          <input type="text" name="street" class="form-control" value="<%= occurrence.street %>">
        </div>

        <div class="mb-3">
          <label class="form-label">Bairro</label>
          <input type="text" name="district" class="form-control" value="<%= occurrence.district %>">
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label class="form-label">CEP</label>
            <input type="text" name="postcode" class="form-control" value="<%= occurrence.postcode %>">
          </div>
          <div class="col-md-6 mb-3">
            <label class="form-label">Cidade</label>
            <input type="text" name="city" class="form-control" value="<%= occurrence.city %>" readonly>
          </div>
        </div>

        <div class="mb-3">
          <label class="form-label">Nome do local</label>
          <input type="text" name="placeName" class="form-control" value="<%= occurrence.placeName || '' %>" placeholder="Ex: Farmácia, Escola...">
        </div>

        <!-- Coordenadas (somente leitura) -->
        <div class="row mb-3">
          <div class="col-6">
            <label class="form-label">Latitude</label>
            <div class="coord-display"><%= occurrence.latitude %></div>
          </div>
          <div class="col-6">
            <label class="form-label">Longitude</label>
            <div class="coord-display"><%= occurrence.longitude %></div>
          </div>
        </div>

        <!-- Dados da Ocorrência -->
        <div class="form-section-divider">
          <span><i class="bi bi-exclamation-triangle me-1"></i>Dados da Ocorrência</span>
        </div>

        <div class="mb-3">
          <label class="form-label">Tipo da ocorrência <span class="text-danger">*</span></label>
          <select name="type" class="form-select" required>
            <% occurrenceTypes.forEach(t => { %>
              <option value="<%= t.value %>" <%= occurrence.type === t.value ? 'selected' : '' %>><%= t.label %></option>
            <% }) %>
          </select>
        </div>

        <div class="mb-4">
          <label class="form-label">Descrição <span class="text-muted">(opcional)</span></label>
          <textarea name="description" class="form-control" rows="4"><%= occurrence.description || '' %></textarea>
        </div>

        <!-- Ações -->
        <div class="d-flex gap-2 flex-wrap">
          <button type="submit" class="btn btn-success flex-grow-1">
            <i class="bi bi-check-lg me-1"></i>Salvar alterações
          </button>
          <a href="/ocorrencias/<%= occurrence.id %>" class="btn btn-outline-secondary">
            Cancelar
          </a>
        </div>

      </form>
    </div>
  </div>
</div>

<%- include('./includes/footer') %>
