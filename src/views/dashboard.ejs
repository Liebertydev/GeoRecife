<%- include('./includes/head'); %>
<%- include('./includes/nav'); %>

<!-- INCLUDE: MESSAGE -->
<%- include('./includes/messages') %>

<main class="dashboard-page" data-page="dashboard">
  <div class="container dashboard-container">

    <!-- Cabeçalho -->
    <header class="dashboard-header">
      <div class="dashboard-header-text">
        <span class="dashboard-eyebrow">
          <span class="dashboard-eyebrow-dot" aria-hidden="true"></span>
          Ao vivo
        </span>
        <h1>Painel de monitoramento</h1>
        <p>
          Acompanhe em tempo real as ocorrências registradas na plataforma —
          distribuição por tipo, por bairro e indicadores principais.
        </p>
      </div>

      <a href="/mapa" class="btn btn-success btn-lg dashboard-cta">
        <i class="bi bi-map-fill me-2" aria-hidden="true"></i>Ver no mapa
      </a>
    </header>

    <!-- KPI row -->
    <section class="kpi-row" aria-label="Indicadores principais">

      <article class="kpi-card kpi-card--emerald">
        <div class="kpi-card-head">
          <span class="kpi-label">Ocorrências registradas</span>
          <span class="kpi-card-icon">
            <i class="bi bi-clipboard-data-fill" aria-hidden="true"></i>
          </span>
        </div>
        <p class="kpi-value" id="totalOcorrencias" data-counter>0</p>
        <p class="kpi-trend" id="totalTrend" hidden></p>
      </article>

      <article class="kpi-card kpi-card--amber">
        <div class="kpi-card-head">
          <span class="kpi-label">Tipo com mais registros</span>
          <span class="kpi-card-icon">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
          </span>
        </div>
        <p class="kpi-value kpi-value--text" id="topTipo">—</p>
      </article>

      <article class="kpi-card kpi-card--sky">
        <div class="kpi-card-head">
          <span class="kpi-label">Bairro com mais ocorrências</span>
          <span class="kpi-card-icon">
            <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
          </span>
        </div>
        <p class="kpi-value kpi-value--text" id="topBairro">—</p>
      </article>

    </section>

    <!-- Charts -->
    <section class="dashboard-charts">

      <!-- Chart principal -->
      <article class="chart-card chart-card--main">
        <header class="chart-header">
          <div class="chart-header-text">
            <span class="chart-title">
              <i class="bi bi-pie-chart-fill" aria-hidden="true"></i>
              Ocorrências por tipo
            </span>
            <p class="chart-summary" id="resumoTipo">Carregando dados…</p>
          </div>
        </header>
        <div class="chart-body">
          <canvas id="graficoPizza"></canvas>
        </div>
      </article>

      <!-- Chart secundário -->
      <article class="chart-card">
        <header class="chart-header">
          <div class="chart-header-text">
            <span class="chart-title">
              <i class="bi bi-bar-chart-fill" aria-hidden="true"></i>
              Ocorrências por bairro
            </span>
            <p class="chart-summary" id="resumoBairro">Carregando dados…</p>
          </div>
          <select id="filtroTipo" class="form-select form-select-sm w-auto chart-filter">
            <option value="todos">Todos os tipos</option>
            <% occurrenceTypes.forEach(t => { %>
              <option value="<%= t.value %>"><%= t.label %></option>
            <% }) %>
          </select>
        </header>
        <div class="chart-body">
          <canvas id="graficoBarra"></canvas>
        </div>
      </article>

    </section>

  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<%- include('./includes/footer'); %>
