<%- include('./includes/head'); %>
  <%- include('./includes/nav'); %>
    <%- include('./includes/messages'); %>

      <main class="hero">

        <!-- ══ HERO ══ -->
        <section class="hero-section">
          <div class="container">

            <div class="hero-grid">

              <!-- Coluna de texto -->
              <div class="hero-text">

                <span class="hero-eyebrow">
                  <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                  Inteligência urbana &middot; Recife
                </span>

                <h1 class="hero-title">
                  Monitore a cidade em <span class="hero-title-accent">tempo real</span>
                </h1>

                <p class="hero-subtitle">
                  Acompanhe acidentes, alagamentos, ocorrências de segurança e áreas
                  de risco — tudo em um mapa interativo, atualizado de forma contínua.
                </p>

                <div class="hero-cta">
                  <a href="/mapa" class="btn-hero btn-hero--primary">
                    <i class="bi bi-map-fill" aria-hidden="true"></i>
                    Ver mapa
                  </a>
                  <% if (user) { %>
                    <a href="/ocorrencias/nova" class="btn-hero btn-hero--ghost">
                      <i class="bi bi-plus-circle" aria-hidden="true"></i>
                      Registrar ocorrência
                    </a>
                  <% } else { %>
                    <a href="/login" class="btn-hero btn-hero--ghost">
                      <i class="bi bi-person-fill" aria-hidden="true"></i>
                      Entrar
                    </a>
                  <% } %>
                </div>

                <ul class="hero-meta" aria-label="Características da plataforma">
                  <li><i class="bi bi-broadcast" aria-hidden="true"></i> Atualização contínua</li>
                  <li><i class="bi bi-shield-check" aria-hidden="true"></i> Dados abertos</li>
                  <li><i class="bi bi-grid-1x2-fill" aria-hidden="true"></i> <%= occurrenceTypes.length %> categorias</li>
                </ul>

              </div>

              <!-- Coluna do preview -->
              <div class="hero-preview">

                <div class="hero-preview-card">

                  <div class="hero-preview-chrome">
                    <span class="chrome-dot chrome-dot--red"></span>
                    <span class="chrome-dot chrome-dot--yellow"></span>
                    <span class="chrome-dot chrome-dot--green"></span>
                    <span class="chrome-url">
                      <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                      georecife.app/mapa
                    </span>
                  </div>

                  <div class="hero-preview-body">
                    <img src="/assets/img/mapa3.png" class="hero-map-img" alt="Pré-visualização do mapa do Recife com ocorrências">

                    <!-- Stat card flutuante: status do sistema -->
                    <div class="hero-floating-card hero-floating-card--top">
                      <span class="hero-floating-dot" aria-hidden="true"></span>
                      <div class="hero-floating-text">
                        <strong>Ao vivo</strong>
                        <span>Monitoramento contínuo</span>
                      </div>
                    </div>

                    <!-- Stat card flutuante: categorias -->
                    <div class="hero-floating-card hero-floating-card--bottom">
                      <i class="bi bi-grid-1x2-fill" aria-hidden="true"></i>
                      <div class="hero-floating-text">
                        <strong><%= occurrenceTypes.length %> categorias</strong>
                        <span>Acompanhadas no mapa</span>
                      </div>
                    </div>
                  </div>

                </div>

              </div>

            </div>

          </div>
        </section>

        <!-- ══ FUNCIONALIDADES ══ -->
        <div class="features-section">

          <div class="container py-4 py-md-5">

            <div class="row g-4 justify-content-center">

              <div class="col-12 col-sm-6 col-md-4">

                <div class="feat-card feat-card--amber">

                  <div class="feat-icon">
                    <i class="bi bi-geo-alt-fill"></i>
                  </div>

                  <h5>Registro de Ocorrências</h5>

                  <p>
                    Marque e registre incidentes diretamente no mapa interativo da cidade do Recife.
                  </p>

                </div>

              </div>

              <div class="col-12 col-sm-6 col-md-4">

                <div class="feat-card feat-card--blue">

                  <div class="feat-icon">
                    <i class="bi bi-bar-chart-fill"></i>
                  </div>

                  <h5>Dashboard Analítico</h5>

                  <p>
                    Visualize estatísticas e padrões de ocorrências por bairro e categoria.
                  </p>

                </div>

              </div>

              <div class="col-12 col-sm-6 col-md-4">

                <div class="feat-card feat-card--green">

                  <div class="feat-icon">
                    <i class="bi bi-shield-fill-check"></i>
                  </div>

                  <h5>Segurança Urbana</h5>

                  <p>
                    Dados em tempo real para apoiar decisões e melhorar a segurança na cidade.
                  </p>

                </div>

              </div>

            </div>

          </div>

        </div>

        <!-- ══ SOBRE NÓS ══ -->
        <div class="team-section">

          <div class="container py-5">

            <div class="text-center mb-5">

              <h2 class="team-title">Sobre Nós</h2>

              <p class="team-subtitle">
                O time por trás do GeoRecife
              </p>

            </div>

            <div class="row g-4">

              <div class="col-12 col-sm-6 col-lg-4">

                <div class="team-card">

                  <div class="team-avatar">
                    <i class="bi bi-graph-up-arrow fs-5"></i>
                  </div>

                  <div class="team-info">
                    <h6>Heitor</h6>
                    <span class="team-role">Dados &amp; Análise</span>
                    <p>Pesquisa de dados e análise de ocorrências urbanas.</p>
                  </div>

                </div>

              </div>

              <div class="col-12 col-sm-6 col-lg-4">

                <div class="team-card">

                  <div class="team-avatar">
                    <i class="bi bi-window fs-5"></i>
                  </div>

                  <div class="team-info">
                    <h6>Vanessa, Lufyo &amp; Lieberty</h6>
                    <span class="team-role">Front-end</span>
                    <p>Desenvolvimento de interfaces e validação visual.</p>
                  </div>

                </div>

              </div>

              <div class="col-12 col-sm-6 col-lg-4">

                <div class="team-card">

                  <div class="team-avatar">
                    <i class="bi bi-cpu fs-5"></i>
                  </div>

                  <div class="team-info">
                    <h6>Lieberty &amp; Ananda</h6>
                    <span class="team-role">Back-end</span>
                    <p>APIs, lógica de negócios e arquitetura de servidor.</p>
                  </div>

                </div>

              </div>

              <div class="col-12 col-sm-6 col-lg-4">

                <div class="team-card">

                  <div class="team-avatar">
                    <div class="team-avatar">
                      <i class="bi bi-database fs-5"></i>
                    </div>
                  </div>

                  <div class="team-info">
                    <h6>Caio &amp; Heitor</h6>
                    <span class="team-role">Banco de Dados</span>
                    <p>Administração e modelagem do banco de dados.</p>
                  </div>

                </div>

              </div>

              <div class="col-12 col-sm-6 col-lg-4">

                <div class="team-card">

                  <div class="team-avatar">
                    <div class="team-avatar">
                      <i class="bi bi-plug fs-5"></i>
                    </div>
                  </div>

                  <div class="team-info">
                    <h6>Geovanne</h6>
                    <span class="team-role">Integração</span>
                    <p>Integração de sistemas entre front-end e back-end.</p>
                  </div>

                </div>

              </div>

              <div class="col-12 col-sm-6 col-lg-4">

                <div class="team-card">

                  <div class="team-avatar">
                    <i class="bi bi-check-circle fs-5"></i>
                  </div>

                  <div class="team-info">
                    <h6>Geovanne</h6>
                    <span class="team-role">Qualidade</span>
                    <p>Testes e controle de qualidade da plataforma.</p>
                  </div>

                </div>

              </div>

            </div>

            <!-- CTA FINAL -->
            <div class="d-flex justify-content-center mt-5">

              <% if (!user) { %>

                <a href="/login">
                  <button class="btn btn-success btn-lg px-5 bg-green btn-aument fw-bold">
                    Faça Login
                  </button>
                </a>

                <% } else { %>

                  <a href="/ocorrencias">
                    <button class="btn btn-success btn-lg px-5 bg-green btn-aument fw-bold">
                      Ver ocorrências
                    </button>
                  </a>

                  <% } %>

            </div>

          </div>

        </div>

      </main>

      <%- include('./includes/footer'); %>