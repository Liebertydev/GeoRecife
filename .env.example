# Copy this file to .env and fill in the real values.
# Never commit .env — it contains secrets. Only .env.example is tracked.

# ─────────────────────────────────────────────────────────────
# RUNTIME
# ─────────────────────────────────────────────────────────────
# Use "development" locally (cookies work over HTTP, helmet disabled,
# CSRF cookie name is "csrf-token").
# Use "production" only when the app is served over HTTPS — otherwise
# Secure cookies and the __Host- CSRF cookie will not be set.
NODE_ENV=development


# ─────────────────────────────────────────────────────────────
# SESSION
# ─────────────────────────────────────────────────────────────
# Long random string used to sign the session cookie.
# Generate with:  openssl rand -hex 32
SESSION_SECRET=replace-me-with-a-long-random-string


# ─────────────────────────────────────────────────────────────
# CSRF (csrf-csrf)
# ─────────────────────────────────────────────────────────────
# Independent secret used to sign the double-submit CSRF token.
# Must be set or the app will throw on the first request.
# Generate with:  openssl rand -hex 32
CSRF_SECRET=replace-me-with-a-long-random-string


# ─────────────────────────────────────────────────────────────
# DATABASE (Supabase Postgres)
# ─────────────────────────────────────────────────────────────
# DATABASE_URL — used by the runtime Prisma client (src/database/prisma.js).
# Should point at the Supabase Transaction-mode pooler (port 6543, pgbouncer).
# Find it in Supabase: Project Settings → Database → Connection string → "Transaction".
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# DIRECT_URL — used by Prisma migrations and prisma.config.ts.
# Should point at the Supabase Session-mode pooler (port 5432).
# Find it in Supabase: Project Settings → Database → Connection string → "Session".
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres
