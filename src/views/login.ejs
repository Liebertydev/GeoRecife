<%- include('./includes/head', { pageCSS: pageCSS }); %>
<%- include('./includes/nav'); %>
<%- include('./includes/messages'); %>

<div class="auth-wrapper">

  <div class="auth-card">

    <h2 class="auth-title">Login</h2>

    <p class="auth-subtitle">
      Entre na sua conta para continuar
    </p>

    <form action="/login/login" method="POST">

      <input
        type="hidden"
        name="_csrf"
        value="<%= csrfToken %>"
      >

      <div class="mb-3">
        <label class="form-label">Email</label>

        <input
          type="email"
          class="form-control"
          name="email"
          placeholder="Digite seu email"
          required
        >
      </div>

      <div class="mb-3">
        <label class="form-label">Senha</label>

        <input
          type="password"
          class="form-control"
          name="password"
          placeholder="Digite sua senha"
          required
        >
      </div>

      <div class="text-end mb-4 auth-forgot">
        <a href="#">
          Esqueceu sua senha?
        </a>
      </div>

      <div class="d-grid mb-3">
        <button class="btn btn-success btn-lg fw-bold">
          Entrar
        </button>
      </div>

      <p class="auth-footer-text mb-0">
        Não tem uma conta?

        <a href="/register">
          Cadastre-se
        </a>
      </p>

    </form>

  </div>

</div>

<%- include('./includes/footer'); %>