<%- include('./includes/head', { pageCSS: pageCSS }); %>
<%- include('./includes/nav') %>

<div id="map-layout">

  <!-- ===================== SIDEBAR (desktop) ===================== -->
  <aside class="map-sidebar">

    <div class="map-sidebar-header">
      <h4>Filtros</h4>
      <p>Filtre as ocorrências exibidas no mapa.</p>
    </div>

    <div class="map-filter-group">

      <% occurrenceTypes.forEach(t => { %>
        <label class="map-filter-item">
          <input type="checkbox" name="filter" value="<%= t.value %>">
          <span><%= t.label %></span>
        </label>
      <% }) %>

    </div>

    <button id="filtrarOcc">
      Aplicar filtros
    </button>

  </aside>

  <!-- ===================== MAPA ===================== -->
  <main class="map-content">

    <!-- BUSCA -->
    <div class="map-search-wrapper">

      <div class="map-search-box">
        <input
          type="text"
          id="searchInput"
          placeholder="Busque por um local..."
          autocomplete="off"
        >
        <button id="searchBtn" aria-label="Buscar">
          <i class="bi bi-search"></i>
        </button>
      </div>

      <!-- Sugestões: ficam DENTRO do wrapper para herdar position:relative -->
      <div id="suggestions" class="list-group"></div>

    </div>

    <!-- MAPA -->
    <div id="map"></div>

    <!-- BOTÃO REGISTRAR -->
    <button id="btnRegistrarOcorrencia">
      <i class="bi bi-plus-lg"></i>
      Registrar ocorrência
    </button>

    <!-- BOTÃO FILTROS  (mobile / tablet) -->
    <button id="mobileFilterBtn" aria-label="Abrir filtros">
      <i class="bi bi-sliders"></i>
      Filtros
    </button>

  </main>

</div>

<!-- ===================== MOBILE FILTER BOTTOM SHEET ===================== -->
<!--
  Fora do #map-layout para garantir position:fixed correto
  e evitar qualquer clipping de overflow pai.
-->
<div id="mobileFilterPanel" role="dialog" aria-modal="true" aria-label="Filtros">

  <div class="mobile-sheet">

    <!-- Pill handle (drag hint) -->
    <div class="sheet-handle" aria-hidden="true"></div>

    <!-- Header -->
    <div class="mobile-filter-header">
      <h5>Filtros</h5>
      <button id="closeMobileFilter" aria-label="Fechar filtros">
        <i class="bi bi-x-lg"></i>
      </button>
    </div>

    <!-- Checkboxes (scrolláveis) -->
    <div class="mobile-filter-body">

      <% occurrenceTypes.forEach(t => { %>
        <label class="map-filter-item">
          <input type="checkbox" name="filter-mobile" value="<%= t.value %>">
          <span><%= t.label %></span>
        </label>
      <% }) %>

    </div>

    <!-- Footer fixo com botão aplicar -->
    <div class="mobile-filter-footer">
      <button id="applyMobileFilters">
        Aplicar filtros
      </button>
    </div>

  </div>

</div>

<!-- Footer fora do viewport (mantido como estava) -->
<div style="position: fixed; bottom: -9999px; left: -9999px; visibility: hidden;">
  <%- include('./includes/footer') %>
</div>

<script>
  /* ================================================
     MOBILE FILTER SHEET
  ================================================ */
  const mobileFilterBtn    = document.getElementById('mobileFilterBtn');
  const mobileFilterPanel  = document.getElementById('mobileFilterPanel');
  const closeMobileFilter  = document.getElementById('closeMobileFilter');
  const applyMobileFilters = document.getElementById('applyMobileFilters');

  function openSheet() {
    mobileFilterPanel.classList.add('active');
    document.body.style.overflow = 'hidden'; // trava scroll do body
  }

  function closeSheet() {
    mobileFilterPanel.classList.remove('active');
    document.body.style.overflow = '';
  }

  mobileFilterBtn.addEventListener('click', openSheet);
  closeMobileFilter.addEventListener('click', closeSheet);

  // Fecha ao clicar no overlay (fora do sheet)
  mobileFilterPanel.addEventListener('click', (e) => {
    if (e.target === mobileFilterPanel) closeSheet();
  });

  // Fecha com ESC
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileFilterPanel.classList.contains('active')) {
      closeSheet();
    }
  });

  applyMobileFilters.addEventListener('click', () => {
    // Sincroniza filtros mobile → desktop (opcional mas útil)
    const mobileChecked = [...document.querySelectorAll('[name="filter-mobile"]:checked')]
      .map(cb => cb.value);

    document.querySelectorAll('[name="filter"]').forEach(cb => {
      cb.checked = mobileChecked.includes(cb.value);
    });

    closeSheet();

    // TODO: disparar lógica real de filtros aqui
    // aplicarFiltros(mobileChecked);
  });

  /* ================================================
     SUGESTÕES DE BUSCA
     (garante que nunca fique atrás de outros elementos)
  ================================================ */
  const searchInput  = document.getElementById('searchInput');
  const suggestions  = document.getElementById('suggestions');

  // Exemplo de listener – substitua pela sua lógica real de geocoding
  searchInput.addEventListener('input', () => {
    const q = searchInput.value.trim();
    if (!q) {
      suggestions.innerHTML = '';
      return;
    }
    // TODO: chamar API de geocoding e popular #suggestions
  });

  // Fecha sugestões ao clicar fora
  document.addEventListener('click', (e) => {
    if (!e.target.closest('.map-search-wrapper')) {
      suggestions.innerHTML = '';
    }
  });
</script>
