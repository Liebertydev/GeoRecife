<%- include('./includes/head'); %>
<%- include('./includes/nav'); %>

<!-- INCLUDE: MESSAGE -->
<%- include('./includes/messages') %>

<main class="hero" data-page="dashboard">
  <div class="container py-6 py-md-5">

    <!-- Cabeçalho -->
    <div class="row mb-4 dashboard-header">
      <div class="col-12">
        <div class="d-flex align-items-center gap-2 mb-1">
          <span style="width:8px;height:8px;border-radius:50%;background:var(--green);display:inline-block;"></span>
          <span style="font-size:.75rem;font-weight:700;color:var(--green);letter-spacing:.8px;text-transform:uppercase;">Ao vivo</span>
        </div>
        <h1>Dashboard de Ocorrências</h1>
        <p>
          Visualize os dados registrados na plataforma GeoRecife. Os gráficos e estatísticas abaixo mostram o panorama das ocorrências na cidade.
        </p>
      </div>
    </div>

    <!-- Área principal -->
    <div class="row g-4 align-items-stretch">

      <!-- ── GRÁFICOS ── -->
      <div class="col-12 col-md-8 d-flex flex-column gap-4">

        <!-- GRÁFICO 1: TIPOS (SEM FILTRO) -->
        <div class="chart-card">
          <div class="chart-header">
            <span class="chart-title">
              <i class="bi bi-pie-chart-fill"></i>
              Ocorrências por Tipo
            </span>
          </div>
          <div class="chart-body">
            <canvas id="graficoPizza"></canvas>
          </div>
        </div>

        <!-- GRÁFICO 2: BAIRRO (COM FILTRO) -->
        <div class="chart-card">
          <div class="chart-header">
            <span class="chart-title">
              <i class="bi bi-bar-chart-fill"></i>
              Ocorrências por Bairro
            </span>
            <select id="filtroTipo" class="form-select form-select-sm w-auto">
              <option value="todos">Todos os tipos</option>
              <% occurrenceTypes.forEach(t => { %>
                <option value="<%= t.value %>"><%= t.label %></option>
              <% }) %>
            </select>
          </div>
          <div class="chart-body">
            <canvas id="graficoBarra"></canvas>
          </div>
        </div>

      </div>

      <!-- ── CARDS LATERAIS ── -->
      <div class="col-12 col-md-4 d-flex flex-column gap-4">

        <!-- Total -->
        <div class="stat-card">
          <div class="stat-icon" style="background:var(--green);color:var(--white); display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-clipboard-data-fill"></i>
          </div>
          <p class="stat-value" id="totalOcorrencias">0</p>
          <p class="stat-label">OCORRÊNCIAS REGISTRADAS</p>
        </div>

        <!-- Tipo mais comum -->
        <div class="stat-card">
          <div class="stat-icon" style="background:var(--red);color:var(--white); display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-exclamation-triangle-fill"></i>
          </div>
          <p class="stat-value-sm" id="topTipo">Carregando...</p>
          <p class="stat-label">TIPO COM MAIS REGISTROS</p>
        </div>

        <!-- Bairro destaque -->
        <div class="stat-card">
          <div class="stat-icon" style="background:var(--green);color:var(--white); display: flex; align-items: center; justify-content: center;">
            <i class="bi bi-geo-alt-fill"></i>
          </div>
          <p class="stat-value-sm" id="topBairro">Carregando...</p>
          <p class="stat-label">BAIRRO COM MAIS OCORRÊNCIAS</p>
        </div>

        <!-- Botão mapa -->
        <a href="/mapa" class="btn btn-success btn-lg fw-bold w-100 mt-auto" style="padding:.85rem;letter-spacing:.3px;">
          <i class="bi bi-map-fill me-2"></i>Ver no Mapa
        </a>

      </div>

    </div>
  </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<%- include('./includes/footer'); %>
